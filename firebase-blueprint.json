{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student public profile information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique user ID"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        }
      },
      "required": ["id", "email"]
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Student English learning practice progress",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Progress document ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner student user ID"
        },
        "lastText": {
          "type": "string",
          "description": "Last practiced text"
        },
        "selectedTier": {
          "type": "string",
          "description": "Selected difficulty tier"
        },
        "shadowingCount": {
          "type": "number",
          "description": "Number of sentences shadowed"
        },
        "quizScore": {
          "type": "number",
          "description": "Highest quiz score"
        },
        "unlockedBadges": {
          "type": "array",
          "description": "List of unlocked badge IDs",
          "items": {
            "type": "string"
          }
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "userId", "updatedAt"]
    },
    "SavedLesson": {
      "title": "SavedLesson",
      "description": "Saved English practice lesson created by the student",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique lesson ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner student user ID"
        },
        "title": {
          "type": "string",
          "description": "Title of the lesson"
        },
        "rawText": {
          "type": "string",
          "description": "Original raw text content"
        },
        "selectedTier": {
          "type": "string",
          "description": "Selected difficulty tier (easy, medium, hard)"
        },
        "sentenceCount": {
          "type": "number",
          "description": "Total number of sentences"
        },
        "wordCount": {
          "type": "number",
          "description": "Total number of words"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when lesson was saved"
        }
      },
      "required": ["id", "userId", "title", "rawText", "createdAt"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Assigned lesson created by teacher/admin to share via link",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique assignment ID"
        },
        "title": {
          "type": "string",
          "description": "Title of the assigned lesson"
        },
        "rawText": {
          "type": "string",
          "description": "Reading text content for the assignment"
        },
        "selectedTier": {
          "type": "string",
          "description": "Assigned difficulty level"
        },
        "className": {
          "type": "string",
          "description": "Class or group target"
        },
        "teacherNotes": {
          "type": "string",
          "description": "Teacher instructions and requirements"
        },
        "dueDate": {
          "type": "string",
          "description": "Optional deadline for submission"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "title", "rawText", "createdAt"]
    },
    "AssignmentSubmission": {
      "title": "AssignmentSubmission",
      "description": "Student homework submission with practice results reported back to admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique submission ID"
        },
        "assignmentId": {
          "type": "string",
          "description": "ID of the associated assignment"
        },
        "studentName": {
          "type": "string",
          "description": "Full name of the student"
        },
        "studentClass": {
          "type": "string",
          "description": "Class or grade of the student"
        },
        "shadowingCount": {
          "type": "number",
          "description": "Number of sentences shadowed"
        },
        "shadowingAvgScore": {
          "type": "number",
          "description": "Average pronunciation accuracy score"
        },
        "quizScore": {
          "type": "number",
          "description": "Percentage score in reading quiz"
        },
        "quizCorrectCount": {
          "type": "number",
          "description": "Number of correct quiz questions"
        },
        "quizTotal": {
          "type": "number",
          "description": "Total number of quiz questions"
        },
        "wordHuntCompleted": {
          "type": "boolean",
          "description": "Whether the word hunt task was completed"
        },
        "dictationScore": {
          "type": "number",
          "description": "Highest score achieved in dictation"
        },
        "studentNote": {
          "type": "string",
          "description": "Note or reflection from student"
        },
        "submittedAt": {
          "type": "string",
          "description": "Submission timestamp"
        }
      },
      "required": ["id", "assignmentId", "studentName", "submittedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Student profile document"
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": "StudentProgress",
      "description": "Student learning progress document"
    },
    "/users/{userId}/savedLessons/{lessonId}": {
      "schema": "SavedLesson",
      "description": "Saved lesson documents created by the student"
    },
    "/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Shared assignment accessible via link"
    },
    "/assignments/{assignmentId}/submissions/{submissionId}": {
      "schema": "AssignmentSubmission",
      "description": "Student submission results reported back to admin"
    }
  }
}
